# Kopiere diese Datei nach "secrets.yaml" und trage dort deine echten Werte ein.
# secrets.yaml gehört NICHT ins Git-Repo (siehe .gitignore).

wifi_ssid: "DeinWifiName"
wifi_password: "DeinWifiPasswort"

# OTA-Passwort für Over-the-Air-Updates
ota_gasmester: "DeinOtaPasswort"

# 32-Byte Base64 Encryption Key für die Home Assistant API
# In ESPHome/Home Assistant automatisch generierbar, siehe:
# https://esphome.io/components/api.html#configuration-variables
api_encryption_key: "DeinBase64EncryptionKey"
